# Application
AUTH_SECURITY_APP_NAME=Auth Security Suite
AUTH_SECURITY_DEBUG=false
AUTH_SECURITY_HOST=0.0.0.0
AUTH_SECURITY_PORT=8000

# Target login site
AUTH_SECURITY_BASE_URL=https://issuer-evrc.viitorcloud.in/auth
AUTH_SECURITY_LOGIN_PATH=/login
AUTH_SECURITY_LOGIN_EMAIL=manil.jayswal@viitor.cloud
AUTH_SECURITY_EMAIL_PLACEHOLDER=everycred@example.com
AUTH_SECURITY_SIGN_IN_BUTTON_TEXT=Sign In
AUTH_SECURITY_DASHBOARD_URL_PATTERN=.*/dashboard.*

# Brute-force defaults
AUTH_SECURITY_START_LENGTH=8
# Leave empty to start from the beginning; set e.g. 000001*E to resume
AUTH_SECURITY_START_FROM=
AUTH_SECURITY_HEADLESS=true
AUTH_SECURITY_NAV_TIMEOUT_MS=8000
AUTH_SECURITY_ERROR_TIMEOUT_MS=3000
AUTH_SECURITY_PROGRESS_LOG_INTERVAL=100

# Character sets
AUTH_SECURITY_DIGITS=0123456789
AUTH_SECURITY_LETTERS=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ
AUTH_SECURITY_SPECIAL=!@#$%^&*
